{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skyjo Game Submission",
  "type": "object",
  "required": ["nb_joueurs", "joueurs"],
  "properties": {
    "nb_joueurs": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8,
      "description": "Nombre de joueurs (2-8)"
    },
    "joueurs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["joueur", "id", "prenom", "nom", "score"],
        "properties": {
          "joueur": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "description": "Numéro du joueur"
          },
          "id": {
            "type": ["integer", "null"],
            "description": "ID du joueur en base de données"
          },
          "prenom": {
            "type": ["string", "null"],
            "description": "Prénom du joueur"
          },
          "nom": {
            "type": ["string", "null"],
            "description": "Nom du joueur"
          },
          "score": {
            "type": "integer",
            "description": "Score total du joueur"
          }
        },
        "additionalProperties": false
      },
      "description": "Tableau des joueurs avec leurs scores"
    }
  },
  "additionalProperties": false
}